# Optional OAuth client IDs for the connected sources. These are PUBLIC identifiers
# (PKCE / token-model flows, no client secret), safe to ship in the static build.
# Copy to web/.env.local for development. Each can also be pasted in the app under
# Settings → Connections instead, so none of them is required.

# Google Calendar, Tasks, Drive (metadata) and YouTube — "Web application" OAuth client
VITE_GOOGLE_CLIENT_ID=
# Optional: URL of your token relay (relay/ — a tiny Cloudflare Worker that holds the Google client
# secret) so Google sign-in renews in the background instead of lasting ~1 hour.
VITE_GOOGLE_RELAY_URL=
# Outlook calendar, Microsoft To Do and OneDrive — Entra ID app registered as "Single-page application"
VITE_MS_CLIENT_ID=
# Spotify recently played — app in the Spotify developer dashboard
VITE_SPOTIFY_CLIENT_ID=
# Dropbox recent files — scoped-access app with PKCE
VITE_DROPBOX_APP_KEY=
